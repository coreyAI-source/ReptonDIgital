{
  "name": "repton-digital-website",
  "version": "0.1.0",
  "private": true,
  "description": "Repton Digital website (Next.js App Router): websites, AI automation and custom software for Perth businesses.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
