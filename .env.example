# ---------------------------------------------------------------------------
# Repton Digital website: environment configuration
#
# Copy to .env.local for local development. On Vercel, add the same names under
# Project Settings > Environment Variables. Never commit real values.
# NEXT_PUBLIC_* values are built into the site, so set them before each build.
# See README.md for the full setup and the pre-launch checklist.
# ---------------------------------------------------------------------------

# --- Public settings (safe for the browser) ---------------------------------

# Canonical address of the live site, with no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional public contact email, shown in the footer and on the contact page.
NEXT_PUBLIC_CONTACT_EMAIL=

# Google Analytics 4 measurement ID, for example G-XXXXXXXXXX. Leave blank to disable.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Meta Pixel ID (digits only). Leave blank to disable.
NEXT_PUBLIC_META_PIXEL_ID=

# Cloudflare Turnstile site key (public). Pair with TURNSTILE_SECRET_KEY below.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Enquiry email (server only, never sent to the browser) ------------------

# Resend API key, from https://resend.com/api-keys.
RESEND_API_KEY=

# Address that receives enquiries.
ENQUIRY_TO_EMAIL=

# Sender on a domain verified in Resend, for example
# "Repton Digital <enquiries@your-verified-domain.com.au>".
ENQUIRY_FROM_EMAIL=

# --- Optional lead webhook (server only, HTTPS only) -------------------------

# Receives each confirmed enquiry as JSON. Leave blank to skip.
LEAD_WEBHOOK_URL=

# Optional secret, sent to the webhook as "Authorization: Bearer <secret>".
LEAD_WEBHOOK_SECRET=

# --- Optional spam protection (server only) ----------------------------------

# Cloudflare Turnstile secret key. When set, every enquiry must pass the challenge.
TURNSTILE_SECRET_KEY=
